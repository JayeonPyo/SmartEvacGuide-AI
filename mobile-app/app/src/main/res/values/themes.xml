<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.IoTChallenge" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- 전체 포인트 컬러 -->
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorSecondary">@color/brand_blue</item>

        <!-- 배경 흰색 -->
        <item name="android:windowBackground">@android:color/white</item>

        <!-- ✅ AlertDialog 테마 연결 -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.IoTChallenge.RoundedDialog</item>
    </style>

    <style name="Theme.IoTChallenge" parent="Base.Theme.IoTChallenge" />

    <!-- ✅ 여기서 다이얼로그 배경을 drawable로 강제 -->
    <style name="ThemeOverlay.IoTChallenge.RoundedDialog"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@drawable/dialog_bg_white</item>
        <item name="colorPrimary">@android:color/black</item>
    </style>

</resources>